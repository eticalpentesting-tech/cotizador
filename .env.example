# Copiá este archivo a ".env" y completá tus valores REALES.
# .env NO se commitea (está en .gitignore). En Render usás el dashboard de Environment Variables, no este archivo.

# Clave del dueño para /admin. CAMBIALA: no dejes el default.
ADMIN_PASS=cambiame_por_una_clave_segura

# Persistencia (opcional). Si usás Upstash (plan free), pegá acá la URL y el token.
# Sin esto, el catálogo vive solo en el archivo local y se pierde al redeployar en Render free.

UPSTASH_REDIS_REST_URL="https://open-gator-223298.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAA2hCAAIgcDJmYmVjMTNjNTI0Yzk0NjBkODllYTExYzZiYzVhOGZhMw"

# Puerto: en dev podés dejarlo vacío (default 8000). Render lo inyecta en producción.
PORT=
